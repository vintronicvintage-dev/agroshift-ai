# Copy to .env.local and fill in. Without these two values the app runs in guest mode:
# the dashboard is open, sign-in and sign-up explain that they are not connected.
#
# Supabase dashboard > Project Settings > API (Data API URL) and API Keys (publishable key).
# The publishable key is safe in the browser. Never put a secret / service_role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
